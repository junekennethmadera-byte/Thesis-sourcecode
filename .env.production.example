PORT=8000
NODE_ENV=production
TRUST_PROXY=true
ALLOW_LEGACY_BEARER=false
DATABASE_URL=postgresql://edata_app:replace-with-a-database-password@db:5432/edata_banking
JWT_SECRET=replace-with-at-least-64-random-characters-from-a-secret-manager
OPENAI_API_KEY=replace-with-provider-secret
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_EMBEDDINGS_REQUIRED=true
PLAGIARISM_API_URL=https://approved-provider.example/api/check
PLAGIARISM_API_KEY=replace-with-provider-secret
MALWARE_SCAN_REQUIRED=true
CLAMSCAN_PATH=/usr/bin/clamscan
PASSWORD_RESET_WEBHOOK_URL=https://approved-mail-service.example/password-reset
OCR_ENABLED=true
OCR_MAX_PAGES=20
OCR_MIN_TEXT=120
BACKUP_DIR=/var/backups/edata
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
SEED_DEMO_ACCOUNTS=false
